<?xml version="1.0" encoding="utf-8"?>
<!-- Diffuse keeps nothing worth migrating: its Drive credentials are encrypted with a key that
     never leaves this phone (so a copy can't be decrypted elsewhere), and what's backed up is
     read back from Drive itself. Excluding everything means a new phone starts clean: connect
     Drive once and it recognises the existing backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
