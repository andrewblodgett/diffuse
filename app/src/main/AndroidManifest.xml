<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ====================================================================
         READ-ONLY GUARANTEE — this manifest is the first line of it.

         Diffuse performs a strictly one-way backup. It reads on-device data
         and never modifies it. The OS enforces that guarantee: the app holds
         ONLY the READ permissions below. It declares NO write permission
         (no WRITE_SMS — which does not even exist as a runtime permission;
         no WRITE_CALL_LOG; no WRITE_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE)
         and NEVER requests the default-SMS role. Any attempt to write to
         content://sms, content://call_log, or MediaStore would therefore throw
         a SecurityException at runtime.

         Do not add a write permission here. scripts/check-readonly.sh fails the
         build if one appears.

         (INTERNET / ACCESS_NETWORK_STATE are for uploading to Google Drive; they do
         not grant any access to local user data.)
         ==================================================================== -->

    <!-- Local user data: READ ONLY. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- READ_MEDIA_VISUAL_USER_SELECTED is deliberately NOT declared: it would let Android 14's
         "select photos" choice become a lasting partial grant, and a backup of only some photos
         looks complete when it isn't. Without full access, photos are reported as skipped.
         (Lint's SelectedPhotoAccess check is disabled in app/build.gradle.kts for this reason.) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- Messages are optional: on a device without telephony, media still backs up. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Network (for Google Drive upload). Not local-data access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Backup UX / scheduling. None of these grant access to user data; they let the
         scheduled backup run as a foreground data-sync job and post progress/result
         notifications. No WRITE/MANAGE/role permission here — the read-only guard forbids it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diffuse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Diffuse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager runs the scheduled backup as a data-sync foreground job.
             On SDK 34+ the OS (and the androidx.work SpecifyForegroundServiceType
             lint check) requires the service's foregroundServiceType to be declared
             here explicitly; the worker also sets it at runtime in
             BackupWorker.foregroundInfo(). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
